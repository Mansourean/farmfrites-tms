# Copy this file to .env.local (git-ignored) and adjust for your machine/deployment.
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL for a future REST/SAP backend (see src/services/api.js).
# Leave as /api to call same-origin through your reverse proxy.
VITE_API_URL=/api

# Where app state (trips, users, columns, layout prefs) is persisted:
#   local  - browser localStorage (default, survives refresh/restart)
#   memory - in-process only, cleared on reload (useful for tests/kiosk previews)
VITE_STORAGE_DRIVER=local

# Shows the one-click "Demo Accounts" panel on the login screen, which displays
# plaintext demo passwords. Keep this false for any real deployment; set to true
# only for the sales/management demo build.
VITE_ENABLE_DEMO_ACCOUNTS=false
