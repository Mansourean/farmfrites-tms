# Loaded automatically by `npm run build`. Safe defaults for a real deployment.
# To enable the plaintext demo-accounts panel for a specific live demo build only,
# override this in a git-ignored .env.production.local instead of editing this file:
#   VITE_ENABLE_DEMO_ACCOUNTS=true
VITE_API_URL=/api
VITE_STORAGE_DRIVER=local
VITE_ENABLE_DEMO_ACCOUNTS=false
